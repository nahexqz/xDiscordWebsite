// ============================================
// LEGENDARY COMMUNITY — PRISMA SCHEMA
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id                String   @id @default(cuid())
  discordId         String   @unique
  username          String
  discriminator     String   @default("0")
  email             String?
  avatar            String?
  banner            String?
  phone             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isAdmin           Boolean  @default(false)
  isBanned          Boolean  @default(false)
  banReason         String?
  lastSeen          DateTime?
  
  // Relations
  wallet            Wallet?
  orders            Order[]
  verifications     VerificationSubmission[]
  tickets           Ticket[]
  ticketReplies     TicketReply[]
  adminLogs         AdminLog[]   @relation("AdminPerformer")
  targetLogs        AdminLog[]   @relation("AdminTarget")
  sessions          Session[]

  @@map("users")
}

// ============================================
// SESSION MODEL
// ============================================
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================
// WALLET MODEL
// ============================================
model Wallet {
  id           String             @id @default(cuid())
  userId       String             @unique
  balance      Int                @default(0) // in satang (1 THB = 100 satang)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

// ============================================
// WALLET TRANSACTION MODEL
// ============================================
model WalletTransaction {
  id          String            @id @default(cuid())
  walletId    String
  amount      Int               // positive = credit, negative = debit
  type        TransactionType
  description String
  orderId     String?
  createdAt   DateTime          @default(now())
  
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  PURCHASE
}

// ============================================
// PRODUCT CATEGORY MODEL
// ============================================
model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  emoji       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  products    Product[]

  @@map("product_categories")
}

// ============================================
// PRODUCT MODEL
// ============================================
model Product {
  id              String          @id @default(cuid())
  categoryId      String?
  name            String
  slug            String          @unique
  description     String
  shortDesc       String?
  price           Int             // in satang
  originalPrice   Int?            // for showing discount
  image           String?
  roleId          String          // Discord role ID to grant
  roleName        String
  duration        Int?            // days, null = permanent
  stock           Int?            // null = unlimited
  soldCount       Int             @default(0)
  isActive        Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  sortOrder       Int             @default(0)
  stripeProductId String?
  stripePriceId   String?
  benefits        String[]        @default([])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  orders          Order[]

  @@map("products")
}

// ============================================
// ORDER MODEL
// ============================================
model Order {
  id                  String      @id @default(cuid())
  userId              String
  productId           String
  amount              Int         // in satang
  currency            String      @default("thb")
  status              OrderStatus @default(PENDING)
  stripeSessionId     String?     @unique
  stripePaymentIntent String?
  couponId            String?
  discountAmount      Int         @default(0)
  roleGranted         Boolean     @default(false)
  roleGrantedAt       DateTime?
  dmSent              Boolean     @default(false)
  failureReason       String?
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  user                User        @relation(fields: [userId], references: [id])
  product             Product     @relation(fields: [productId], references: [id])
  coupon              Coupon?     @relation(fields: [couponId], references: [id])

  @@map("orders")
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// ============================================
// COUPON MODEL
// ============================================
model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  discountType   DiscountType
  discountValue  Int        // percentage or fixed amount in satang
  minOrderAmount Int        @default(0)
  maxUses        Int?
  usedCount      Int        @default(0)
  isActive       Boolean    @default(true)
  expiresAt      DateTime?
  productIds     String[]   @default([]) // empty = all products
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  orders         Order[]

  @@map("coupons")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ============================================
// VERIFICATION SUBMISSION MODEL
// ============================================
model VerificationSubmission {
  id                String             @id @default(cuid())
  userId            String
  level             Int                // 1, 2, or 3
  status            VerificationStatus @default(PENDING)
  
  // Level 1 fields
  firstName         String
  lastName          String
  birthdate         DateTime
  discordUid        String
  email             String
  phone             String
  phoneVerified     Boolean            @default(false)
  facebookUrl       String?
  instagramUrl      String?
  otherSocialUrl    String?
  profileScreenshot String?            // Cloudinary URL
  
  // Level 2 fields
  selfieImage       String?            // Cloudinary URL (camera only)
  
  // Level 3 fields
  idCardImage       String?            // Cloudinary URL (camera only)
  
  // Review
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectReason      String?
  discordMessageId  String?            // ID of the admin channel message
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  user              User               @relation(fields: [userId], references: [id])

  @@map("verification_submissions")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================
// TICKET MODEL
// ============================================
model Ticket {
  id           String       @id @default(cuid())
  userId       String
  ticketNumber Int          @default(autoincrement())
  category     String
  subject      String
  message      String
  screenshot   String?
  status       TicketStatus @default(PENDING)
  priority     Priority     @default(MEDIUM)
  assignedTo   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  user         User         @relation(fields: [userId], references: [id])
  replies      TicketReply[]

  @@map("tickets")
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  FAILED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// TICKET REPLY MODEL
// ============================================
model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("ticket_replies")
}

// ============================================
// ADMIN LOG MODEL
// ============================================
model AdminLog {
  id           String   @id @default(cuid())
  performerId  String
  targetId     String?
  action       String
  description  String
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())
  
  performer    User     @relation("AdminPerformer", fields: [performerId], references: [id])
  target       User?    @relation("AdminTarget", fields: [targetId], references: [id])

  @@map("admin_logs")
}

// ============================================
// ANNOUNCEMENT MODEL
// ============================================
model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, warning, success, error
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

// ============================================
// BOT SETTINGS MODEL
// ============================================
model BotSettings {
  id                    String   @id @default(cuid())
  key                   String   @unique
  value                 String
  description           String?
  updatedAt             DateTime @updatedAt

  @@map("bot_settings")
}

// ============================================
// DISCORD ROLE MAPPING MODEL
// ============================================
model DiscordRoleMapping {
  id          String   @id @default(cuid())
  productId   String?  @unique
  roleId      String   @unique
  roleName    String
  type        String   // shop, verification_l1, verification_l2, verification_l3
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("discord_role_mappings")
}

// ============================================
// SITE SETTINGS MODEL
// ============================================
model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string") // string, json, boolean, number
  description String?
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}
